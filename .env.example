# ==============================================================================
# .env.example - Plantilla de Variables de Entorno Seguras
# Copia este archivo como .env y completa los valores con tus credenciales de producción.
# ==============================================================================

# Entorno y Puertos Locales
WEB_PORT=80
CHAT_PORT=8000

# Base de Datos MySQL (Producción / Hosting / Local)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u123456789_fundacion
DB_USER=u123456789_admin
DB_PASSWORD=Tu_Contrasena_De_Base_De_Datos_Segura!

# Clave Criptográfica JWT (Mínimo 64 caracteres hexadecimales / 256 bits)
# Generar con: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=tu_clave_secreta_jwt_de_produccion_aleatoria_y_muy_segura_256_bits

# Clave Secreta del Chatbot FastAPI (Render)
CHAT_SECRET_KEY=tu_clave_secreta_chat_produccion_aleatoria

# Proveedores de IA para el Chatbot
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
GROQ_API_KEY=
GEMINI_API_KEY=
# Configuración de Voz Ultra-Realista ElevenLabs (TTS Chatbot)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=htFfPSZGJwjBv1CL0aMD
