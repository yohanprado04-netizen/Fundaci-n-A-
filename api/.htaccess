# ==============================================================================
# api/.htaccess - Aislamiento Estricto y Protección de Componentes Internos
# ==============================================================================

# Deshabilitar listado de directorios
Options -Indexes

# Bloquear acceso a archivos sensibles, claves criptográficas y registros
<FilesMatch "^\.|\.jwt_secret|\.env|\.sql$|\.log$|\.key$|\.secret$">
    Require all denied
    Order allow,deny
    Deny from all
</FilesMatch>

# Bloquear acceso directo a archivos internos que solo deben ser incluidos por PHP
<FilesMatch "^(config|middleware|mailer|formularios)\.php$">
    Require all denied
    Order allow,deny
    Deny from all
</FilesMatch>

# Bloquear acceso web directo a la carpeta de controladores
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^controllers(/|$) - [F,L]
</IfModule>
