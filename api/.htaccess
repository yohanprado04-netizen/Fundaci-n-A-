# Bloquea el acceso directo a los archivos internos: solo index.php,
# upload.php y seed.php deben poder abrirse desde el navegador.
<FilesMatch "^(config|db|auth|entidades)\.php$">
    Require all denied
</FilesMatch>

# Nunca listar el contenido de la carpeta
Options -Indexes

# Cabeceras de seguridad básicas
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
</IfModule>
